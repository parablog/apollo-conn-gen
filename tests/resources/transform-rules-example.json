{
  "description": "Example transform rules for operation names",
  "rules": [
    {
      "pattern": "create(.*)",
      "replacement": "create_$1"
    },
    {
      "pattern": "([a-z])([A-Z])",
      "replacement": "$1_$2",
      "enabled": false
    },
    {
      "pattern": "get(.*)",
      "replacement": "fetch$1",
      "description": "Replace 'get' prefix with 'fetch'",
      "enabled": false
    },
    {
      "pattern": "By([A-Z][a-z]*)",
      "replacement": "By$1"
    },
    {
      "pattern": "updateUserByUsername",
      "replacement": "updateUser"
    }
  ]
} 