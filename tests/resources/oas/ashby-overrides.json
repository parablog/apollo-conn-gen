{
  "$source": {
    "isSuccess": "$.success",
    "errors": {
      "message": "$($.errors?->first?.message ?? 'Ashby request failed')",
      "extensions": "httpStatus: $status"
    },
    "payload": "results"
  },
  "$match": [
    {
      "pattern": "^post:/.*\\.(list\\w*|info|search\\w*|fetch|interviewerSettings|getRecentEmailMessages|generate|synchronous)$",
      "root": "query"
    }
  ]
}
